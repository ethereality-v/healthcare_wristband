#include <Wire.h>
#include <DFRobot_MAX30102.h>

// ESP32 default I2C pins
#define SDA_PIN 21
#define SCL_PIN 22

DFRobot_MAX30102 particleSensor;

int32_t SPO2;            // SpO2 value (%)
int8_t  SPO2Valid;       // 1 if SpO2 calculation is valid
int32_t heartRate;       // Heart rate (BPM)
int8_t  heartRateValid;  // 1 if heart rate calculation is valid

void setup() {
  Serial.begin(115200);
  delay(1000);                    // Give the serial monitor time to connect

  Wire.begin(SDA_PIN, SCL_PIN);   // ESP32: SDA = GPIO21, SCL = GPIO22

  // Retry until the sensor is found
  while (!particleSensor.begin()) {
    Serial.println("MAX30102 not found! Check wiring.");
    delay(1000);
  }
  Serial.println("MAX30102 initialized.");

  // Configuration: LED brightness (0-255), sample average, LED mode,
  // sample rate (Hz), pulse width, ADC range
  particleSensor.sensorConfiguration(
    60,               // LED brightness
    SAMPLEAVG_4,      // Average 4 samples
    MODE_MULTILED,    // Red + IR (required for SpO2)
    SAMPLERATE_100,   // 100 samples/sec
    PULSEWIDTH_411,   // 411 us pulse width (18-bit resolution)
    ADCRANGE_16384    // ADC range
  );

  Serial.println("Place your finger on the sensor and hold still...");
}

void loop() {
  // Collects a batch of samples and calculates HR and SpO2
  // (blocks for a few seconds each call)
  particleSensor.heartrateAndOxygenSaturation(
    &SPO2, &SPO2Valid, &heartRate, &heartRateValid
  );

  Serial.print("Heart rate: ");
  if (heartRateValid) {
    Serial.print(heartRate);
    Serial.print(" BPM");
  } else {
    Serial.print("--");
  }

  Serial.print(" | SpO2: ");
  if (SPO2Valid) {
    Serial.print(SPO2);
    Serial.println(" %");
  } else {
    Serial.println("--");
  }
}
